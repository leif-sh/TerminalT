{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TerminalT",
  "version": "0.1.0-14",
  "identifier": "com.terminalt.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TerminalT",
        "width": 1280,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "TerminalT Contributors",
    "copyright": "Copyright © 2026 TerminalT Contributors",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "Local-first Windows SSH and SFTP client",
    "longDescription": "TerminalT is a local-first Windows desktop SSH client with secure host verification, multi-session terminals, SFTP transfers, encrypted credential storage and diagnostic tools.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
